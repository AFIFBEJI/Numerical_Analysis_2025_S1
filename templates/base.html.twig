<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Interpolation Lab{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') }}?v={{ random() }}">
    {# Favicon: use SVG logo if available, with a PNG fallback if you add one to public/images #}
    <link rel="icon" type="image/svg+xml" href="{{ asset('images/logo.svg') }}">
    <link rel="alternate icon" href="{{ asset('images/logo.svg') }}">
    <meta name="theme-color" content="#6b5ce8">
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="nav-container">
                <a href="{{ path('app_home') }}" class="nav-brand">
                    <img src="{{ asset('images/logo.svg') }}" alt="Interpolation Lab" class="nav-logo">
                </a>
                {% set route = app.request.attributes.get('_route') %}
                {% set querySection = app.request.query.get('section') %}
                {% set activeSection = route == 'app_cours' ? querySection : null %}

                <ul class="nav-menu">
                    <li><a href="{{ path('app_home') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_home' ? 'active' : '' }}">Home</a></li>
                    <li><a href="{{ path('app_lagrange') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_lagrange' ? 'active' : '' }}">Lagrange</a></li>
                    <li><a href="{{ path('app_newton') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_newton' ? 'active' : '' }}">Newton</a></li>
                    <li><a href="{{ path('app_least_squares') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_least_squares' ? 'active' : '' }}">Moindres Carrés</a></li>
                    <li><a href="{{ path('app_gradient') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_gradient' ? 'active' : '' }}">Descente de Gradient</a></li>
                    <li class="nav-dropdown" id="coursDropdown">
                        <a href="#" class="nav-link {{ route == 'app_cours' ? 'active' : '' }}" onclick="toggleDropdown(event)">
                            Cours ▾
                        </a>
                        <ul class="dropdown-menu" id="coursMenu">
                            <li><a href="{{ path('app_cours') }}?section=lagrange" class="{{ activeSection == 'lagrange' ? 'active' : '' }}">Lagrange</a></li>
                            <li><a href="{{ path('app_cours') }}?section=newton" class="{{ activeSection == 'newton' ? 'active' : '' }}">Newton</a></li>
                            <li><a href="{{ path('app_cours') }}?section=erreur" class="{{ activeSection == 'erreur' ? 'active' : '' }}">Erreur d'interpolation</a></li>
                            <li><a href="{{ path('app_cours') }}?section=moindres" class="{{ activeSection == 'moindres' ? 'active' : '' }}">Moindres Carrés</a></li>
                            <li><a href="{{ path('app_cours') }}?section=gradient" class="{{ activeSection == 'gradient' ? 'active' : '' }}">Descente de Gradient</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <main>
        {% block body %}{% endblock %}
    </main>

    {% block javascripts %}{% endblock %}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.0.1"></script>
    <script>
    function toggleDropdown(e) {
        e.preventDefault();
        const menu = document.getElementById('coursMenu');
        const isOpen = menu.style.display === 'block';
        menu.style.display = isOpen ? 'none' : 'block';
    }
    // Fermer si on clique ailleurs
    document.addEventListener('click', function(e) {
        const dd = document.getElementById('coursDropdown');
        if (dd && !dd.contains(e.target)) {
            document.getElementById('coursMenu').style.display = 'none';
        }
    });
    </script>
</body>
</html>
