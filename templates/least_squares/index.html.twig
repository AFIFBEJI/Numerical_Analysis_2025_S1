{% extends 'base.html.twig' %}

{% block title %}Moindres Carrés - Interpolation{% endblock %}

{% block body %}
<div class="container method-page method-page-moindres">
    <div class="page-header">
        <h1>Moindres Carrés</h1>
        <p>Ajustement polynomial par régression pour l'approximation de données</p>
    </div>

    <div class="content-grid">
        <div class="input-section">

            {% if error %}
                <div class="error-message">
                    <strong>Erreur :</strong> {{ error }}
                </div>
            {% endif %}

            <form method="post" id="leastSquaresForm" class="points-form">
                <h2>Saisie des points</h2>

                <div class="form-description">
                    <p>Entrez au moins 2 points et choisissez le degré du polynôme d'approximation.</p>
                </div>

                <div class="point-row">
                    <div class="input-group">
                        <label>Degré du polynôme :</label>
                        <input type="number" name="degree" min="1" value="{{ degree|default(1) }}" required>
                    </div>
                </div>

                <div id="pointsContainer" class="points-container" style="margin-top: 1rem;">
                    {% if pointsX is not empty %}
                        {% for i in 0..(pointsX|length - 1) %}
                            <div class="point-row">
                                <div class="input-group">
                                    <label>x{{ i }} :</label>
                                    <input type="number" step="any" name="x[]" value="{{ pointsX[i] }}" required>
                                </div>
                                <div class="input-group">
                                    <label>y{{ i }} :</label>
                                    <input type="number" step="any" name="y[]" value="{{ pointsY[i] }}" required>
                                </div>
                                {% if i >= 2 %}
                                    <button type="button" onclick="this.parentNode.remove(); updateLabels();" class="btn-remove">×</button>
                                {% endif %}
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="point-row">
                            <div class="input-group">
                                <label>x₀ :</label>
                                <input type="number" step="any" name="x[]" required>
                            </div>
                            <div class="input-group">
                                <label>y₀ :</label>
                                <input type="number" step="any" name="y[]" required>
                            </div>
                        </div>
                        <div class="point-row">
                            <div class="input-group">
                                <label>x₁ :</label>
                                <input type="number" step="any" name="x[]" required>
                            </div>
                            <div class="input-group">
                                <label>y₁ :</label>
                                <input type="number" step="any" name="y[]" required>
                            </div>
                        </div>
                    {% endif %}
                </div>

                <div class="form-actions">
                    <button type="button" onclick="addPoint()" class="btn-secondary">
                        <span>+</span> Ajouter un point
                    </button>
                    <button type="button" onclick="removePoint()" class="btn-warning">
                        <span>-</span> Supprimer un point
                    </button>
                    <button type="submit" class="btn-primary">Calculer & Visualiser</button>
                </div>
            </form>

            {% if pointsX is not empty %}
                <div class="points-table-section">
                    <h3>Points saisis</h3>
                    <table class="points-table">
                        <thead>
                            <tr>
                                <th>Point</th>
                                {% for x in pointsX %}<th>P{{ loop.index0 }}</th>{% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>x</strong></td>
                                {% for x in pointsX %}<td>{{ x }}</td>{% endfor %}
                            </tr>
                            <tr>
                                <td><strong>y</strong></td>
                                {% for y in pointsY %}<td>{{ y }}</td>{% endfor %}
                            </tr>
                        </tbody>
                    </table>
                </div>
            {% endif %}

            <div style="margin-top: 1.25rem;">
                <a href="{{ path('app_cours') }}?section=moindres" class="btn-secondary" style="width:100%;text-align:center;">
                    Voir le cours des Moindres Carrés
                </a>
            </div>

        </div>

        <div class="results-section">

            {% if result %}
                <div class="results-card">
                    <h2>Résultats de l'approximation</h2>

                    <div class="coefficients-section">
                        <div class="coefficients-header">
                            <h3>Coefficients du polynôme</h3>
                        </div>
                        <div class="coefficients-list">
                            {% for coeff in result %}
                                <div class="coefficient-item">
                                    <span class="coefficient-label">a{{ loop.index0 }}</span>
                                    <span class="coefficient-value">{{ coeff }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    {% if polynomial is defined and polynomial %}
                        <div class="polynomial-section">
                            <h3>Polynôme d'approximation</h3>
                            <div class="polynomial-display">
                                P(x) = {{ polynomial|raw }}
                            </div>
                        </div>
                    {% endif %}
                </div>
            {% endif %}

            {% if chartData is defined and chartData %}
                <div class="chart-section">
                    <h3>Visualisation graphique</h3>
                    <div class="chart-container">
                        <canvas id="lsChart"></canvas>
                    </div>
                    <!-- Légende dupliquée supprimée (affichage géré par Chart.js) -->
                </div>
            {% else %}
                <div class="placeholder-chart">
                    <div class="placeholder-content">
                        <h3>Visualisation en attente</h3>
                        <p>Entrez des points et cliquez sur "Calculer & Visualiser" pour voir le graphique</p>
                    </div>
                </div>
            {% endif %}

        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
let pointCount = {{ pointsX is not empty ? pointsX|length : 2 }};

function addPoint() {
    const container = document.getElementById('pointsContainer');
    const row = document.createElement('div');
    row.className = 'point-row';
    row.innerHTML = `
        <div class="input-group">
            <label>x${pointCount} :</label>
            <input type="number" step="any" name="x[]" required>
        </div>
        <div class="input-group">
            <label>y${pointCount} :</label>
            <input type="number" step="any" name="y[]" required>
        </div>
        <button type="button" onclick="this.parentNode.remove(); updateLabels();" class="btn-remove">×</button>
    `;
    container.appendChild(row);
    pointCount++;
    updateLabels();
}

function removePoint() {
    const container = document.getElementById('pointsContainer');
    if (container.children.length > 2) {
        container.lastElementChild.remove();
        pointCount--;
        updateLabels();
    }
}

function updateLabels() {
    const rows = document.getElementById('pointsContainer').children;
    for (let i = 0; i < rows.length; i++) {
        const labels = rows[i].querySelectorAll('label');
        if (labels[0]) labels[0].textContent = `x${i} :`;
        if (labels[1]) labels[1].textContent = `y${i} :`;
    }
}

{% if chartData is defined and chartData %}
document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('lsChart').getContext('2d');

    const pointsX = {{ chartData.points|map(p => p.x)|json_encode|raw }};
    const pointsY = {{ chartData.points|map(p => p.y)|json_encode|raw }};
    const pointsDataset = pointsX.map((x, i) => ({ x: parseFloat(x), y: parseFloat(pointsY[i]) }));

    const curveX = {{ chartData.labels|json_encode|raw }};
    const curveY = {{ chartData.data|json_encode|raw }};
    const curveDataset = curveX.map((x, i) => ({ x: x, y: curveY[i] }));

    new Chart(ctx, {
        type: 'scatter',
        data: {
            datasets: [
                {
                    label: "Polynôme d'approximation P(x)",
                    data: curveDataset,
                    borderColor: '#5b4ee6',
                    backgroundColor: 'rgba(91, 78, 230, 0.12)',
                    borderWidth: 3,
                    pointRadius: 0,
                    showLine: true,
                    fill: true,
                    tension: 0.4
                },
                {
                    label: 'Points de données',
                    data: pointsDataset,
                    backgroundColor: '#7a67f2',
                    borderColor: '#ffffff',
                    borderWidth: 2,
                    pointRadius: 8,
                    pointHoverRadius: 10,
                    showLine: false
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'top', labels: { usePointStyle: true, padding: 20 } },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return `(${context.parsed.x.toFixed(2)}, ${context.parsed.y.toFixed(4)})`;
                        }
                    }
                }
            },
            scales: {
                x: {
                    type: 'linear',
                    title: { display: true, text: 'Axe des x', font: { weight: 'bold', size: 14 } },
                    grid: { color: 'rgba(0,0,0,0.1)' }
                },
                y: {
                    type: 'linear',
                    title: { display: true, text: 'P(x)', font: { weight: 'bold', size: 14 } },
                    grid: { color: 'rgba(0,0,0,0.1)' }
                }
            }
        }
    });
});
{% endif %}
</script>
{% endblock %}
